{
  "name": "@baxyz/dev",
  "version": "0.0.0",
  "private": true,
  "description": "baxyz orchestrator — shared workspace, devcontainer, AI guidance, and cross-repo scripts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "install:all": "node scripts/run-each.mjs install",
    "build:all": "node scripts/run-each.mjs build",
    "test:all": "node scripts/run-each.mjs test",
    "lint:all": "node scripts/run-each.mjs lint",
    "status:all": "node scripts/git-each.mjs status -sb",
    "fetch:all": "node scripts/git-each.mjs fetch --all --prune",
    "pull:all": "node scripts/git-each.mjs pull --rebase --autostash",
    "branch:all": "node scripts/git-each.mjs branch --show-current"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.4.0"
}
