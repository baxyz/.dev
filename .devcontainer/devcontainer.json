{
  "name": "baxyz",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  // Orchestrator devcontainer for the baxyz personal workspace.
  //
  // Named volumes for every active baxyz repo, cloned into place by
  // setup-container.sh's postCreateCommand on first run (fresh volume) —
  // never re-clones over existing work. Works identically on GitHub
  // Codespaces and local Docker Desktop/WSL2, unlike the previous
  // host-bind-mount setup.
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "mounts": [
    "source=baxyz-repo-github,target=/workspaces/.github,type=volume",
    "source=baxyz-repo-baxyz-github-io,target=/workspaces/baxyz.github.io,type=volume",
    "source=baxyz-repo-gnome-extensions,target=/workspaces/gnome-extensions,type=volume",
    "source=baxyz-repo-mozlz4,target=/workspaces/mozlz4,type=volume",
    "source=baxyz-repo-sqlite-reader,target=/workspaces/sqlite-reader,type=volume"
  ],
  "containerEnv": {
    "BAXYZ_ORG": "baxyz",
    "BAXYZ_REPOS": ".github baxyz.github.io gnome-extensions mozlz4 sqlite-reader",
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_BAXYZ}"
  },
  // GH_TOKEN: forwards a baxyz-scoped host token into the container so gh
  // and the GitHub VS Code extensions are authenticated out of the box.
  // Set on the host: export GH_TOKEN_FOR_BAXYZ=<token>
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_BAXYZ}"
  },
  "features": {
    // ── Infrastructure ───────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/shell-history-per-project:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    // ── Dev environment ──────────────────────────────────────────────────────
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1.0.5": {},
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "baxyz",
      "license": "AGPL-3.0-only"
    },
    // ── AI ───────────────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/copilot-dev:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1.0.3": {},
    "ghcr.io/helpers4/devcontainer/mistral-dev:1.0.1": {},
    "ghcr.io/helpers4/devcontainer/peon-ping:1": {
      "packsLang": "fr"
    },
    // ── JavaScript ───────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1.0.7": {},
    "ghcr.io/helpers4/devcontainer/nub:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    // ── Testing ──────────────────────────────────────────────────────────────
    // browser-hub's donut-e2e.ts (pnpm test:e2e) launches a real Firefox via
    // Playwright — only Firefox is needed, so Chromium/WebKit are skipped to
    // keep the image smaller.
    "ghcr.io/helpers4/devcontainer/playwright-dev:1": {
      "browsers": "firefox"
    }
  },
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/setup-container.sh"
}
