{
  "name": "baxyz",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  // Orchestrator devcontainer for the baxyz personal workspace.
  //
  // The baxyz repos are cloned by the org-workspace feature into /workspaces/<name>
  // (named Docker volume), identically on GitHub Codespaces and local Docker.
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "mounts": [],
  // Dev servers of the site repos (Astro, VitePress): servers must listen on 0.0.0.0 (--host)
  // so these forwarded ports are reachable from the host browser.
  "forwardPorts": [
    4321,
    4322,
    4323
  ],
  "portsAttributes": {
    "4321": {
      "label": "site-work-arnaud-berenger",
      "onAutoForward": "notify"
    },
    "4322": {
      "label": "site-dev-baxyz",
      "onAutoForward": "notify"
    },
    "4323": {
      "label": "folioscope",
      "onAutoForward": "notify"
    }
  },
  // GH_TOKEN: forwards a baxyz-scoped host token into the container so gh
  // and the GitHub VS Code extensions are authenticated out of the box.
  // Set on the host: export GH_TOKEN_FOR_BAXYZ=<token>
  // Secrets live in remoteEnv, not containerEnv: they are not baked into the container
  // (docker run args / docker inspect) and a rotated token needs a reconnect, not a rebuild.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_BAXYZ}",
    "GRAPHITE_TOKEN": "${localEnv:GRAPHITE_BAXYZ_TOKEN}"
  },
  "features": {
    // ── Infrastructure ───────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/shell-history:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    // ── Dev environment ──────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/org-workspace:1": {
      "autoDiscover": "public,private,internal,fork",
      "generateCodeWorkspace": true
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "baxyz",
      "license": "AGPL-3.0-only"
    },
    // ── AI ───────────────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/copilot-dev:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {
      "remoteControl": true,
      "remoteControlAutoTrust": true
    },
    "ghcr.io/helpers4/devcontainer/mistral-dev:1": {},
    "ghcr.io/helpers4/devcontainer/cline-dev:1": {},
    "ghcr.io/helpers4/devcontainer/graphite-dev:1": {},
    // ── JavaScript ───────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/nub:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {},
    // ── Rust ─────────────────────────────────────────────────────────────────
    // folioscope's core and CLI. Each repo pins its exact toolchain in
    // rust-toolchain.toml; rustup installs it on first cargo call.
    "ghcr.io/devcontainers/features/rust:1": {
      "targets": "wasm32-unknown-unknown"
    },
    // ── Testing ──────────────────────────────────────────────────────────────
    // browser-hub's donut-e2e.ts (pnpm test:e2e) launches a real Firefox via
    // Playwright — only Firefox is needed, so Chromium/WebKit are skipped to
    // keep the image smaller.
    "ghcr.io/helpers4/devcontainer/playwright-dev:1": {
      "browsers": "firefox"
    }
  },
  "remoteUser": "node"
}
