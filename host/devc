#!/usr/bin/env bash
# devc — start, stop and inspect the org devcontainers that live on this host.
#
# Each org keeps its devcontainer in ~/projects/<org>/.dev (brig-id: roots). `devc up <org>`
# builds/starts it with the devcontainer CLI; the claude-dev feature then starts a Claude Code
# Remote Control server inside the container (tmux), which pre-creates a session you can open
# from claude.ai/code or the Claude mobile app.
#
# Secrets (GH_TOKEN_FOR_<ORG>, ...) are read from ~/.config/fajro/secrets.env when it exists,
# otherwise the matching `export` lines of ~/.bashrc are evaluated. Values are never printed.
set -euo pipefail

PROJECTS="${DEVC_PROJECTS:-$HOME/projects}"
SECRETS="${DEVC_SECRETS:-$HOME/.config/fajro/secrets.env}"
SECRET_PREFIXES='GH_TOKEN_FOR_|GRAPHITE_|BITWARDEN_|TURSO_|GOOGLE_AI_|GROQ_'

die() { echo "devc: $*" >&2; exit 1; }

load_env() {
  if [ -f "$SECRETS" ]; then
    set -a; . "$SECRETS"; set +a
  elif [ -f "$HOME/.bashrc" ]; then
    eval "$(grep -E "^[[:space:]]*export[[:space:]]+(${SECRET_PREFIXES})" "$HOME/.bashrc" || true)"
  fi
  # levrier-tech's devcontainer reads GH_TOKEN_FOR_LEVRIER_TECH; accept the older name too.
  if [ -z "${GH_TOKEN_FOR_LEVRIER_TECH:-}" ] && [ -n "${GH_TOKEN_FOR_LEVRIER_PROJECT:-}" ]; then
    GH_TOKEN_FOR_LEVRIER_TECH="$GH_TOKEN_FOR_LEVRIER_PROJECT"
  fi
  local v
  for v in $(compgen -v | grep -E "^(${SECRET_PREFIXES})" || true); do export "$v"; done
}

devcontainer_cli() {
  if command -v devcontainer >/dev/null 2>&1; then devcontainer "$@"; else npx -y @devcontainers/cli "$@"; fi
}

workspace_of() { # org -> workspace folder
  local org="$1" d
  for d in "$PROJECTS/$org/.dev" "$PROJECTS/$org/roots"; do
    if [ -f "$d/.devcontainer/devcontainer.json" ]; then echo "$d"; return; fi
  done
  die "no devcontainer found for '$org' (looked in $PROJECTS/$org/{.dev,roots})"
}

orgs() {
  local d
  for d in "$PROJECTS"/*/; do
    d="${d%/}"
    if [ -f "$d/.dev/.devcontainer/devcontainer.json" ] || [ -f "$d/roots/.devcontainer/devcontainer.json" ]; then
      basename "$d"
    fi
  done
}

container_of() { # workspace folder -> container id (running or not)
  docker ps -aq --filter "label=devcontainer.local_folder=$1" | head -1
}

state_of() {
  local id="$1"
  if [ -z "$id" ]; then echo absent; return; fi
  docker inspect -f '{{.State.Status}}' "$id"
}

cmd_ls() {
  printf '%-16s %-10s %s\n' ORG STATE CONTAINER
  local org ws id
  for org in $(orgs); do
    ws="$(workspace_of "$org")"; id="$(container_of "$ws")"
    printf '%-16s %-10s %s\n' "$org" "$(state_of "$id")" "${id:--}"
  done
}

cmd_up() {
  [ $# -gt 0 ] || die "usage: devc up <org>... | --all"
  local targets=("$@")
  if [ "$1" = "--all" ]; then targets=($(orgs)); fi
  load_env
  local org ws
  for org in "${targets[@]}"; do
    ws="$(workspace_of "$org")"
    echo "→ $org: devcontainer up ($ws)"
    devcontainer_cli up --workspace-folder "$ws" --log-level info 2>&1 | tail -n 3
    cmd_rc "$org" || true
  done
}

cmd_down() {
  [ $# -gt 0 ] || die "usage: devc down <org>... | --all"
  local targets=("$@")
  if [ "$1" = "--all" ]; then targets=($(orgs)); fi
  local org id
  for org in "${targets[@]}"; do
    id="$(container_of "$(workspace_of "$org")")"
    if [ -n "$id" ] && [ "$(state_of "$id")" = running ]; then
      docker stop "$id" >/dev/null && echo "✓ $org stopped"
    else
      echo "· $org not running"
    fi
  done
}

cmd_rebuild() {
  [ $# -eq 1 ] || die "usage: devc rebuild <org>"
  load_env
  devcontainer_cli up --workspace-folder "$(workspace_of "$1")" --remove-existing-container --log-level info 2>&1 | tail -n 3
  cmd_rc "$1" || true
}

cmd_exec() {
  [ $# -ge 2 ] || die "usage: devc exec <org> <command...>"
  local org="$1"; shift
  load_env
  devcontainer_cli exec --workspace-folder "$(workspace_of "$org")" "$@"
}

cmd_shell() { [ $# -eq 1 ] || die "usage: devc shell <org>"; cmd_exec "$1" bash -l; }

cmd_rc() { # Remote Control status inside the container
  [ $# -eq 1 ] || die "usage: devc rc <org>"
  local ws; ws="$(workspace_of "$1")"
  [ "$(state_of "$(container_of "$ws")")" = running ] || die "$1 is not running (devc up $1)"
  echo "— $1 remote control:"
  load_env
  devcontainer_cli exec --workspace-folder "$ws" claude-rc status 2>&1 | sed 's/^/  /' || true
}

cmd_login() { # first start of a container: log in with a claude.ai account
  [ $# -eq 1 ] || die "usage: devc login <org>"
  cmd_exec "$1" claude auth login
}

usage() {
  cat <<'EOF'
devc — org devcontainers on this host

  devc ls                    state of every org devcontainer
  devc up <org>... | --all   build/start (Remote Control starts inside, session pre-created)
  devc down <org>... | --all stop (volumes and clones are kept)
  devc rebuild <org>         recreate the container from devcontainer.json
  devc rc <org>              claude-rc status inside the container
  devc login <org>           claude auth login inside the container (once per container)
  devc exec <org> <cmd...>   run a command inside
  devc shell <org>           interactive shell inside
EOF
}

case "${1:-}" in
  ls|list|"") shift || true; cmd_ls "$@" ;;
  up) shift; cmd_up "$@" ;;
  down|stop) shift; cmd_down "$@" ;;
  rebuild) shift; cmd_rebuild "$@" ;;
  rc|status) shift; cmd_rc "$@" ;;
  login) shift; cmd_login "$@" ;;
  exec) shift; cmd_exec "$@" ;;
  shell|sh) shift; cmd_shell "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
