[Unit]
Description=Claude Code Remote Control server on this host (starts org devcontainers on demand)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude-host start
ExecStop=%h/.local/bin/claude-host stop

[Install]
WantedBy=default.target
